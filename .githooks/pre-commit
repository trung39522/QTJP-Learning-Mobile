#!/bin/sh
# Check the index, including files added with git add -f.
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File tool/check_public_files.ps1 -IndexOnly -CheckIdentity
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File tool/check_public_files.ps1 -IndexOnly -CheckIdentity
fi
echo 'Privacy check needs PowerShell. Install it before committing with this hook enabled.' >&2
exit 1
